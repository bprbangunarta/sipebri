APP_NAME=SIPEBRI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sipebri-v3
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes emails to storage/logs (nothing is sent). For real email codes use `smtp` and fill the rest, e.g.
# MAIL_MAILER=smtp, MAIL_HOST=smtp.example.com, MAIL_PORT=587 (STARTTLS), MAIL_USERNAME / MAIL_PASSWORD of the sending account.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Seconds to wait for the SMTP server before giving up (the sign-in code is sent while the person waits).
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Attachments (survey photos). `public` stores them on this server; `s3` uses the AWS bucket below
# (the adapter is installed). With s3 the photos are served through short-lived signed links.
ATTACHMENTS_DISK=public

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Own cookie name so projects on localhost do not overwrite each other's session.
SESSION_COOKIE=sipebri_session

# Codex: sign-in (/api/web-auth, CODEX_TOKEN) and customer master (OAuth, CODEX_ID / CODEX_SECRET).
# Both are required: without CODEX_ENDPOINT nobody can sign in and applicant lookups fail.
CODEX_ENDPOINT=
CODEX_TOKEN=
CODEX_ID=
CODEX_SECRET=
CODEX_VERIFY=true
# Optional tuning (defaults shown): seconds for a request / for connecting, and seconds before a token expires that it is renewed.
# CODEX_TIMEOUT=10
# CODEX_CONNECT_TIMEOUT=5
# CODEX_TOKEN_SKEW=300

# Shows an approximate address under a saved position (OpenStreetMap Nominatim). The position is sent to that service:
# set to false to keep coordinates inside, or set GEOCODER_ENDPOINT to an own Nominatim instance.
REVERSE_GEOCODING=true

# Two-factor authentication (authenticator app / email code, chosen by each user). Set to false to switch the whole feature off.
MFA_ENABLED=true

# Years an audit log entry is kept before `audit:prune` may remove it.
AUDIT_RETENTION_YEARS=5
