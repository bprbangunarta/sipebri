#!/bin/sh
# The gate before a push: nothing leaves the machine while a check fails. Never skip with --no-verify.
# Git tells this hook through stdin what is about to be sent ("<local ref> <local sha> <remote ref> <remote sha>" per line); from that the
# right range of commits is worked out, whatever branch is checked out.
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
ranges=''

while read -r local_ref local_sha remote_ref remote_sha; do
    # Deleting a branch on the remote carries no commits.
    [ "$local_sha" = "$zero" ] && continue

    if [ "$remote_sha" = "$zero" ]; then
        spec="$local_sha --not --remotes"
    else
        spec="$remote_sha..$local_sha"
    fi

    ranges="${ranges}${spec}
"
done

# Nothing is being sent (only branches being deleted): no commits to check.
[ -n "$ranges" ] || exit 0

VERIFY_RANGE="$ranges" exec "$root/scripts/verify.sh"
