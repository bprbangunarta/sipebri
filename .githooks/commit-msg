#!/bin/sh
# Two gates on the commit's message and content: an approved brief (AGENTS.md, section 3) and no weakened check (.ai/rules/php.md).
# Never skip with --no-verify.
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-brief.sh" "$1" || exit 1
exec "$root/scripts/check-weakened.sh" --staged "$1"
